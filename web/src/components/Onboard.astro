---
import { TOPIC_LABELS } from "../lib/editions";

const topics = Object.entries(TOPIC_LABELS);
---

<dialog
  id="onboard-dialog"
  class="m-auto w-[min(28rem,90vw)] rounded-xl border border-stone-200 p-6 shadow-xl backdrop:bg-stone-900/40"
>
  <h2 class="text-xl font-bold text-stone-900">What do you want in your briefing?</h2>
  <p class="mt-1 text-sm text-stone-600">
    Pick the topics you care about. The top stories of the day are always included.
  </p>
  <form method="dialog" id="onboard-form" class="mt-4">
    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
      {topics.map(([id, label]) => (
        <label
          class="flex cursor-pointer items-center gap-2 rounded-lg border border-stone-200 px-3 py-2 text-sm hover:bg-stone-50 has-checked:border-amber-400 has-checked:bg-amber-50"
        >
          <input type="checkbox" name="topic" value={id} class="accent-amber-600" />
          {label}
        </label>
      ))}
    </div>
    <div class="mt-5 flex items-center justify-between">
      <button
        type="button"
        id="onboard-skip"
        class="text-sm text-stone-500 underline underline-offset-2 hover:text-stone-800"
        >Show me everything</button
      >
      <button
        type="submit"
        id="onboard-save"
        class="rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700"
        >Save my topics</button
      >
    </div>
  </form>
</dialog>

<template id="rest-of-today-template">
  <details class="mt-8 rounded-lg border border-stone-200 bg-stone-100 p-4">
    <summary class="cursor-pointer text-sm font-medium text-stone-700">
      Rest of today
    </summary>
    <div data-rest-container class="mt-3"></div>
  </details>
</template>

<script>
  import { loadPrefs, savePrefs, partitionSections } from "../lib/personalize";

  const dialog = document.getElementById("onboard-dialog") as HTMLDialogElement | null;
  const form = document.getElementById("onboard-form") as HTMLFormElement | null;
  const skipButton = document.getElementById("onboard-skip");
  const settingsButton = document.getElementById("topic-settings-button");

  function applyPrefs(): void {
    const prefs = loadPrefs(localStorage);
    const sections = [...document.querySelectorAll<HTMLElement>("[data-topic-section]")];
    const topicIds = sections.map((s) => s.dataset.topicSection ?? "");
    const { collapsed } = partitionSections(topicIds, prefs);
    const collapsedSet = new Set(collapsed);

    // Reset any previous collapse before reapplying (settings changes rerun this).
    const existing = document.getElementById("rest-of-today");
    const main = document.querySelector("main");
    if (existing) {
      const container = existing.querySelector("[data-rest-container]");
      if (container && main) {
        for (const child of [...container.children]) main.appendChild(child);
      }
      existing.remove();
    }

    const toCollapse = sections.filter((s) => collapsedSet.has(s.dataset.topicSection ?? ""));
    if (toCollapse.length > 0 && main) {
      const template = document.getElementById(
        "rest-of-today-template"
      ) as HTMLTemplateElement | null;
      if (template) {
        const fragment = template.content.cloneNode(true) as DocumentFragment;
        const details = fragment.firstElementChild as HTMLElement;
        details.id = "rest-of-today";
        const container = details.querySelector("[data-rest-container]");
        for (const section of toCollapse) container?.appendChild(section);
        main.appendChild(details);
      }
    }
  }

  function openDialog(preselect: boolean): void {
    if (!dialog) return;
    if (preselect) {
      const prefs = new Set(loadPrefs(localStorage) ?? []);
      for (const box of dialog.querySelectorAll<HTMLInputElement>("input[name=topic]")) {
        box.checked = prefs.has(box.value);
      }
    }
    dialog.showModal();
  }

  form?.addEventListener("submit", () => {
    const chosen = [...form.querySelectorAll<HTMLInputElement>("input[name=topic]:checked")].map(
      (box) => box.value
    );
    savePrefs(localStorage, chosen);
    applyPrefs();
  });

  skipButton?.addEventListener("click", () => {
    savePrefs(localStorage, []);
    dialog?.close();
    applyPrefs();
  });

  settingsButton?.addEventListener("click", () => openDialog(true));

  applyPrefs();
  if (loadPrefs(localStorage) === null && dialog) {
    openDialog(false);
  }
</script>
