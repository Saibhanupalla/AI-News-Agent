---
import StoryCard from "./StoryCard.astro";
import { TOPIC_LABELS, formatDate, type Edition } from "../lib/editions";

interface Props {
  edition: Edition;
}

const { edition } = Astro.props;
const sectionEntries = Object.entries(edition.sections);
---

<article>
  <header>
    <p class="text-sm font-medium uppercase tracking-wide text-amber-700">
      {formatDate(edition.date)}
    </p>
    <p class="mt-2 text-lg leading-relaxed text-stone-700">{edition.intro}</p>
  </header>

  {edition.must_know.length > 0 && (
    <section class="mt-8" aria-labelledby="must-know-heading">
      <h2 id="must-know-heading" class="text-xl font-bold text-stone-900">Must know</h2>
      <div class="mt-3 space-y-3">
        {edition.must_know.map((item) => <StoryCard item={item} emphasis />)}
      </div>
    </section>
  )}

  {sectionEntries.map(([topicId, items]) => (
    <section class="mt-8" data-topic-section={topicId}>
      <h2 class="text-xl font-bold text-stone-900">
        {TOPIC_LABELS[topicId] ?? topicId}
      </h2>
      <div class="mt-3 space-y-3">
        {items.map((item) => <StoryCard item={item} />)}
      </div>
    </section>
  ))}

  {edition.continuing.length > 0 && (
    <section class="mt-8" aria-labelledby="continuing-heading">
      <h2 id="continuing-heading" class="text-xl font-bold text-stone-900">Continuing</h2>
      <p class="mt-1 text-sm text-stone-500">
        Developments in stories from the last few days.
      </p>
      <div class="mt-3 space-y-3">
        {edition.continuing.map((item) => <StoryCard item={item} />)}
      </div>
    </section>
  )}
</article>
