---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import EditionView from "../components/EditionView.astro";
import Onboard from "../components/Onboard.astro";
import { latestEdition } from "../lib/editions";

const edition = latestEdition();
---

<Base title="AI News Briefing">
  <Header showSettings={edition !== null} />
  <main class="mt-6">
    {edition ? (
      <EditionView edition={edition} />
    ) : (
      <div class="py-24 text-center">
        <h1 class="text-2xl font-bold text-stone-900">No edition yet</h1>
        <p class="mt-3 text-stone-600">
          The first daily briefing has not been published. Check back tomorrow morning.
        </p>
      </div>
    )}
  </main>
  {edition && <Onboard />}
</Base>
